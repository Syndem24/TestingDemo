@model TestingDemo.Models.PaginatedList<TestingDemo.Models.ClientModel>
@using TestingDemo.Models
@using System.Linq

@{
    ViewData["Title"] = "Planning Officer Dashboard";
    var requirementCounts = ViewBag.RequirementCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
    var requirementsByClient = ViewBag.Requirements as IDictionary<int, List<PermitRequirementModel>> ?? new Dictionary<int, List<PermitRequirementModel>>();
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-3 col-lg-2">
            @await Html.PartialAsync("_PlanningOfficerNav")
        </div>
        <div class="col-md-9 col-lg-10">
            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h4><i class="bi bi-clipboard-check"></i> Planning Officer Dashboard</h4>
                        <p class="text-muted">Manage permit requirements for clients</p>
                    </div>
                    <div>
                        <a asp-action="PlanningClients" class="btn btn-outline-info">
                            <i class="bi bi-list-task"></i> View Planning Clients
                        </a>
                    </div>
                </div>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ValidationErrors"] != null)
            {
                <div class="alert alert-warning alert-dismissible fade show" role="alert">
                    <i class="bi bi-bug-fill"></i> @TempData["ValidationErrors"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="card shadow-sm">
                <div class="card-header bg-light py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="bi bi-list-ul"></i> @ViewData["ListTitle"]</h5>
                        <span class="badge bg-primary rounded-pill fs-6">@Model.Count()</span>
                    </div>
                </div>
                <div class="card-body p-0">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover table-striped mb-0 align-middle">
                                <thead class="table-dark">
                                    <tr>
                                        <th class="ps-4">Client Information</th>
                                        <th>Permit Type</th>
                                        <th>Status</th>
                                        <th>Priority</th>
                                        <th>Requirements</th>
                                        <th class="text-center" style="width:160px">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        var hasRequirements = requirementsByClient.ContainsKey(item.Id);
                                        var allRequirementsCompleted = false;
                                        var totalRequirements = 0;
                                        var completedRequirements = 0;

                                        if (hasRequirements)
                                        {
                                            var reqList = requirementsByClient[item.Id];
                                            if (reqList != null && reqList.Any())
                                            {
                                                totalRequirements = reqList.Count;
                                                completedRequirements = reqList.Count(r => r.IsCompleted);
                                                allRequirementsCompleted = totalRequirements > 0 && totalRequirements == completedRequirements;
                                            }
                                            else
                                            {
                                                allRequirementsCompleted = true;
                                            }
                                        }
                                        else
                                        {
                                            allRequirementsCompleted = true;
                                        }

                                        <tr class="@(item.UrgencyLevel == "Urgent" ? "table-danger" : item.UrgencyLevel == "Slightly Urgent" ? "table-warning" : "")">
                                            <td class="ps-4">
                                                <div class="d-flex align-items-center">
                                                    <div class="me-3">
                                                        <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                                            <i class="bi bi-person-fill text-white"></i>
                                                        </div>
                                                    </div>
                                                    <div>
                                                        <div class="fw-bold text-dark">@item.ClientName</div>
                                                        <div class="text-muted small">
                                                            <i class="bi bi-telephone me-1"></i>@item.ContactPersonNumber
                                                        </div>
                                                        <div class="text-muted small">
                                                            <i class="bi bi-calendar3 me-1"></i>@item.CreatedDate.ToString("MMM dd, yyyy")
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                @{
                                                    var typeBadgeClass = item.TypeOfProject switch
                                                    {
                                                        "Retainership - BIR" => "bg-danger",
                                                        "Retainership - SPP" => "bg-info",
                                                        "One Time Transaction" => "bg-secondary",
                                                        "External Audit" => "bg-dark",
                                                        _ => "bg-secondary"
                                                    };
                                                }
                                                <span class="badge @typeBadgeClass">@item.TypeOfProject</span>
                                            </td>
                                            <td>
                                                <span class="badge bg-info fs-6">@item.Status</span>
                                            </td>
                                            <td>
                                                @if (item.UrgencyLevel == "Urgent")
                                                {
                                                    <span class="badge bg-danger fs-6">
                                                        <i class="bi bi-exclamation-triangle-fill me-1"></i>Urgent
                                                    </span>
                                                }
                                                else if (item.UrgencyLevel == "Slightly Urgent")
                                                {
                                                    <span class="badge bg-warning text-dark fs-6">
                                                        <i class="bi bi-exclamation-circle me-1"></i>Slightly Urgent
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success fs-6">
                                                        <i class="bi bi-check-circle me-1"></i>Normal
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                @if (totalRequirements > 0)
                                                {
                                                    <div class="d-flex align-items-center">
                                                        <div class="progress me-2" style="width: 60px; height: 8px;">
                                                            <div class="progress-bar @(allRequirementsCompleted ? "bg-success" : "bg-warning")" 
                                                                 style="width: @((double)completedRequirements / totalRequirements * 100)%"></div>
                                                        </div>
                                                        <small class="text-muted">
                                                            @completedRequirements/@totalRequirements
                                                        </small>
                                                        @if (allRequirementsCompleted)
                                                        {
                                                            <i class="bi bi-check-circle-fill text-success ms-1"></i>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-light text-dark">
                                                        <i class="bi bi-plus-circle me-1"></i>No Requirements
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                @if (item.Status == "Planning")
                                                {
                                                    <div class="btn-group btn-group-sm" role="group">
                                                        <button type="button" class="btn btn-outline-info" title="View complete client information"
                                                                data-bs-toggle="modal" data-bs-target="#clientModal-@item.Id">
                                                            <i class="bi bi-eye"></i>
                                                        </button>
                                                        <button type="button" class="btn btn-outline-warning" 
                                                                data-bs-toggle="modal" data-bs-target="#backToFinanceModal-@item.Id" 
                                                                title="Return to Finance">
                                                            <i class="bi bi-arrow-left-circle"></i>
                                                        </button>
                                                        <button type="button" class="btn btn-outline-success" 
                                                                data-bs-toggle="modal" data-bs-target="#proceedToLiaisonModal-@item.Id" 
                                                                title="Send to Liaison">
                                                            <i class="bi bi-check-lg"></i>
                                                        </button>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <button type="button" class="btn btn-outline-info btn-sm" title="View client details"
                                                        data-bs-toggle="modal" data-bs-target="#clientModal-@item.Id">
                                                        <i class="bi bi-eye"></i>
                                                    </button>
                                                }
                                            </td>
                                        </tr>

                                        <!-- Proceed to Liaison Modal -->
                                        <div class="modal fade" id="proceedToLiaisonModal-@item.Id" tabindex="-1">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title">
                                                            <i class="bi bi-arrow-right-circle text-success me-2"></i>Confirm Action
                                                        </h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        @if (allRequirementsCompleted)
                                                        {
                                                            <div class="alert alert-success" role="alert">
                                                                <i class="bi bi-check-circle-fill me-2"></i>
                                                                <strong>All requirements completed!</strong>
                                                            </div>
                                                            <p>Are you sure you want to send <strong>@item.ClientName</strong> to Customer Care for inspection?</p>
                                                            <p class="text-muted small">This action will complete the planning phase and move the client to the next stage.</p>
                                                        }
                                                        else
                                                        {
                                                            <div class="alert alert-warning" role="alert">
                                                                <h4 class="alert-heading"><i class="bi bi-exclamation-triangle-fill"></i> Incomplete Requirements!</h4>
                                                                <p>
                                                                    <strong>@item.ClientName</strong> has <strong>@(totalRequirements - completedRequirements)</strong> pending requirement(s) out of @totalRequirements.
                                                                </p>
                                                                <hr>
                                                                <p class="mb-0">Are you sure you want to proceed? The client will be sent to Liaison/Customer Care with incomplete requirements.</p>
                                                            </div>
                                                        }
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                                            <i class="bi bi-x-circle me-1"></i>Cancel
                                                        </button>
                                                        <form asp-action="ProceedToLiaison" asp-route-id="@item.Id" method="post" style="display:inline;">
                                                            @if (allRequirementsCompleted)
                                                            {
                                                                <button type="submit" class="btn btn-success">
                                                                    <i class="bi bi-check-lg me-1"></i>Proceed to Liaison
                                                                </button>
                                                            }
                                                            else
                                                            {
                                                                <button type="submit" class="btn btn-warning">
                                                                    <i class="bi bi-exclamation-triangle me-1"></i>Proceed Anyway
                                                                </button>
                                                            }
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Back to Finance Modal -->
                                        <div class="modal fade" id="backToFinanceModal-@item.Id" tabindex="-1" aria-labelledby="backToFinanceModalLabel-@item.Id" aria-hidden="true">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <form asp-action="BackToFinance" asp-route-id="@item.Id" method="post">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title" id="backToFinanceModalLabel-@item.Id">
                                                                <i class="bi bi-arrow-left-circle text-warning me-2"></i>Return Client to Finance
                                                            </h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <div class="mb-3">
                                                                <label for="note-@item.Id" class="form-label">
                                                                    <i class="bi bi-chat-left-text me-1"></i>Reason for Return <span class="text-danger">*</span>
                                                                </label>
                                                                <textarea class="form-control" id="note-@item.Id" name="note" rows="4" 
                                                                          placeholder="Please provide a detailed reason for returning this client to Finance..." required></textarea>
                                                                <div class="form-text">This note will help Finance understand what needs to be corrected.</div>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                                                <i class="bi bi-x-circle me-1"></i>Cancel
                                                            </button>
                                                            <button type="submit" class="btn btn-warning">
                                                                <i class="bi bi-arrow-left-circle me-1"></i>Return to Finance
                                                            </button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Client Details Modal -->
                                        <div class="modal fade" id="clientModal-@item.Id" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
                                                <div class="modal-content">
                                                    <div class="modal-header bg-light">
                                                        @{
                                                            var projectBadgeClass = item.TypeOfProject switch
                                                            {
                                                                "Retainership - BIR" => "bg-danger",
                                                                "Retainership - SPP" => "bg-info text-dark",
                                                                "One Time Transaction" => "bg-secondary",
                                                                "External Audit" => "bg-dark",
                                                                _ => "bg-light text-dark"
                                                            };
                                                        }
                                                        <h5 class="modal-title d-flex flex-wrap align-items-center gap-2">
                                                            <i class="bi bi-person-vcard"></i>
                                                            <span>@item.ClientName</span>
                                                            <span class="badge rounded-pill @typeBadgeClass">@item.TypeOfProject</span>
                                                            <span class="badge @(item.Status == "Planning" ? "bg-info" : "bg-secondary")">@item.Status</span>
                                                        </h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <!-- Basic Client Information -->
                                                        <div class="row g-3 mb-4">
                                                            <div class="col-12">
                                                                <h6 class="fw-bold mb-3 text-primary">
                                                                    <i class="bi bi-info-circle me-2"></i>Client Information
                                                                </h6>
                                                            </div>
                                                            <div class="col-12 col-md-6">
                                                                <div class="border rounded p-3 h-100">
                                                                    <small class="text-muted d-block mb-1">Tracking Number</small>
                                                                    <span class="text-monospace fw-bold fs-6">@item.TrackingNumber</span>
                                                                </div>
                                                            </div>
                                                            <div class="col-12 col-md-6">
                                                                <div class="border rounded p-3 h-100">
                                                                    <small class="text-muted d-block mb-1">Submitted Date</small>
                                                                    <span class="fw-bold fs-6">@item.CreatedDate.ToString("yyyy-MM-dd")</span>
                                                                </div>
                                                            </div>
                                                            <div class="col-12 col-md-6">
                                                                <div class="border rounded p-3 h-100">
                                                                    <small class="text-muted d-block mb-1">Contact Number</small>
                                                                    <span class="fw-bold fs-6">@item.ContactPersonNumber</span>
                                                                </div>
                                                            </div>
                                                            <div class="col-12 col-md-6">
                                                                <div class="border rounded p-3 h-100">
                                                                    <small class="text-muted d-block mb-1">Email</small>
                                                                    <span class="fw-bold fs-6">@item.Email</span>
                                                                </div>
                                                            </div>
                                                            <div class="col-12 col-md-6">
                                                                <div class="border rounded p-3 h-100">
                                                                    <small class="text-muted d-block mb-1">Urgency Level</small>
                                                                    <span class="badge @(item.UrgencyLevel == "Urgent" ? "bg-danger" : item.UrgencyLevel == "Slightly Urgent" ? "bg-warning text-dark" : "bg-success") fs-6">@item.UrgencyLevel</span>
                                                                </div>
                                                            </div>
                                                            @if (!string.IsNullOrWhiteSpace(item.RegisteredCompanyAddress))
                                                            {
                                                                <div class="col-12">
                                                                    <div class="border rounded p-3">
                                                                        <small class="text-muted d-block mb-1">Company Address</small>
                                                                        <span class="fw-bold fs-6">@item.RegisteredCompanyAddress</span>
                                                                    </div>
                                                                </div>
                                                            }
                                                        </div>

                                                        @if (!string.IsNullOrWhiteSpace(item.PlanningReturnNote))
                                                        {
                                                            <div class="alert alert-warning py-3 mb-4">
                                                                <h6 class="alert-heading">
                                                                    <i class="bi bi-info-circle"></i> Return Note
                                                                </h6>
                                                                <p class="mb-0">@item.PlanningReturnNote</p>
                                                            </div>
                                                        }

                                                        <hr class="my-4" />
                                                        
                                                        <!-- Project Details Section -->
                                                        <h6 class="fw-bold mb-3 text-primary">
                                                            <i class="bi bi-card-list me-2"></i>Project Details
                                                        </h6>
                                                        <div class="border rounded p-4 mb-4" style="max-height: 400px; overflow-y: auto;">
                                                            @if (item.TypeOfProject == "Retainership - BIR" && item.RetainershipBIR != null)
                                                            {
                                                                <div class="row g-3">
                                                                    <div class="col-12 col-md-6">
                                                                        <small class="text-muted">Type Of Registrant</small>
                                                                        <div class="fw-bold">@item.RetainershipBIR.TypeOfRegistrant</div>
                                                                    </div>
                                                                    <div class="col-12 col-md-6">
                                                                        <small class="text-muted">OCN Notes</small>
                                                                        <div class="fw-bold">@item.RetainershipBIR.OCNNotes</div>
                                                                    </div>
                                                                    <div class="col-12 col-md-6">
                                                                        <small class="text-muted">Date OCN Generated</small>
                                                                        <div class="fw-bold">@item.RetainershipBIR.DateOCNGenerated?.ToString("yyyy-MM-dd")</div>
                                                                    </div>
                                                                    <div class="col-12 col-md-6">
                                                                        <small class="text-muted">Date BIR Registration</small>
                                                                        <div class="fw-bold">@item.RetainershipBIR.DateBIRRegistration?.ToString("yyyy-MM-dd")</div>
                                                                    </div>
                                                                    <div class="col-12 col-md-6">
                                                                        <small class="text-muted">BIR RDO No.</small>
                                                                        <div class="fw-bold">@item.RetainershipBIR.BIRRdoNo</div>
                                                                    </div>
                                                                    @if (!string.IsNullOrWhiteSpace(item.RetainershipBIR.OtherBirRdoNo))
                                                                    {
                                                                        <div class="col-12 col-md-6">
                                                                            <small class="text-muted">Other BIR RDO No.</small>
                                                                            <div class="fw-bold">@item.RetainershipBIR.OtherBirRdoNo</div>
                                                                        </div>
                                                                    }
                                                                    <div class="col-12 col-md-6">
                                                                        <small class="text-muted">Tax Filing Status</small>
                                                                        <div class="fw-bold">@item.RetainershipBIR.TaxFilingStatus</div>
                                                                    </div>
                                                                    <div class="col-12 col-md-6">
                                                                        <small class="text-muted">Need Catch-Up Accounting</small>
                                                                        <div class="fw-bold">@item.RetainershipBIR.NeedCatchUpAccounting</div>
                                                                    </div>
                                                                    @if (!string.IsNullOrWhiteSpace(item.RetainershipBIR.CatchUpReasons))
                                                                    {
                                                                        <div class="col-12">
                                                                            <small class="text-muted">Catch-Up Reasons</small>
                                                                            <div class="fw-bold">@item.RetainershipBIR.CatchUpReasons</div>
                                                                        </div>
                                                                    }
                                                                    @if (!string.IsNullOrWhiteSpace(item.RetainershipBIR.OtherCatchUpReason))
                                                                    {
                                                                        <div class="col-12">
                                                                            <small class="text-muted">Other Catch-Up Reason</small>
                                                                            <div class="fw-bold">@item.RetainershipBIR.OtherCatchUpReason</div>
                                                                        </div>
                                                                    }
                                                                    <div class="col-12 col-md-6">
                                                                        <small class="text-muted">Catch-Up Start Date</small>
                                                                        <div class="fw-bold">@item.RetainershipBIR.CatchUpStartDate?.ToString("yyyy-MM-dd")</div>
                                                                    </div>
                                                                    @if (!string.IsNullOrWhiteSpace(item.RetainershipBIR.BIRComplianceActivities))
                                                                    {
                                                                        <div class="col-12">
                                                                            <small class="text-muted">BIR Compliance Activities</small>
                                                                            <div class="fw-bold">@item.RetainershipBIR.BIRComplianceActivities</div>
                                                                        </div>
                                                                    }
                                                                    @if (!string.IsNullOrWhiteSpace(item.RetainershipBIR.OtherBIRCompliance))
                                                                    {
                                                                        <div class="col-12">
                                                                            <small class="text-muted">Other BIR Compliance</small>
                                                                            <div class="fw-bold">@item.RetainershipBIR.OtherBIRCompliance</div>
                                                                        </div>
                                                                    }
                                                                    <div class="col-12 col-md-6">
                                                                        <small class="text-muted">Retainership Start Date</small>
                                                                        <div class="fw-bold">@item.RetainershipBIR.BIRRetainershipStartDate?.ToString("yyyy-MM-dd")</div>
                                                                    </div>
                                                                </div>
                                                            }
                                                            else if (item.TypeOfProject == "Retainership - SPP" && item.RetainershipSPP != null)
                                                            {
                                                                <div class="row g-3">
                                                                    <div class="col-12 col-md-6">
                                                                        <small class="text-muted">SSS Reg No.</small>
                                                                        <div class="fw-bold">@item.RetainershipSPP.SSSCompanyRegNo</div>
                                                                    </div>
                                                                    <div class="col-12 col-md-6">
                                                                        <small class="text-muted">SSS Reg Date</small>
                                                                        <div class="fw-bold">@item.RetainershipSPP.SSSRegistrationDate?.ToString("yyyy-MM-dd")</div>
                                                                    </div>
                                                                    <div class="col-12 col-md-6">
                                                                        <small class="text-muted">PHIC Reg No.</small>
                                                                        <div class="fw-bold">@item.RetainershipSPP.PHICCompanyRegNo</div>
                                                                    </div>
                                                                    <div class="col-12 col-md-6">
                                                                        <small class="text-muted">PHIC Reg Date</small>
                                                                        <div class="fw-bold">@item.RetainershipSPP.PHICRegistrationDate?.ToString("yyyy-MM-dd")</div>
                                                                    </div>
                                                                    <div class="col-12 col-md-6">
                                                                        <small class="text-muted">HDMF Reg No.</small>
                                                                        <div class="fw-bold">@item.RetainershipSPP.HDMFCompanyRegNo</div>
                                                                    </div>
                                                                    <div class="col-12 col-md-6">
                                                                        <small class="text-muted">HDMF Reg Date</small>
                                                                        <div class="fw-bold">@item.RetainershipSPP.HDMFRegistrationDate?.ToString("yyyy-MM-dd")</div>
                                                                    </div>
                                                                    @if (!string.IsNullOrWhiteSpace(item.RetainershipSPP.SPPComplianceActivities))
                                                                    {
                                                                        <div class="col-12">
                                                                            <small class="text-muted">SPP Compliance Activities</small>
                                                                            <div class="fw-bold">@item.RetainershipSPP.SPPComplianceActivities</div>
                                                                        </div>
                                                                    }
                                                                    @if (!string.IsNullOrWhiteSpace(item.RetainershipSPP.OtherSPPCompliance))
                                                                    {
                                                                        <div class="col-12">
                                                                            <small class="text-muted">Other SPP Compliance</small>
                                                                            <div class="fw-bold">@item.RetainershipSPP.OtherSPPCompliance</div>
                                                                        </div>
                                                                    }
                                                                    <div class="col-12 col-md-6">
                                                                        <small class="text-muted">Retainership Start Date</small>
                                                                        <div class="fw-bold">@item.RetainershipSPP.SPPRetainershipStartDate?.ToString("yyyy-MM-dd")</div>
                                                                    </div>
                                                                </div>
                                                            }
                                                            else if (item.TypeOfProject == "One Time Transaction" && item.OneTimeTransaction != null)
                                                            {
                                                                <div class="row g-3">
                                                                    <div class="col-12 col-md-6">
                                                                        <small class="text-muted">Registrant Type</small>
                                                                        <div class="fw-bold">@item.OneTimeTransaction.TypeOfRegistrant</div>
                                                                    </div>
                                                                    <div class="col-12 col-md-6">
                                                                        <small class="text-muted">Area of Services</small>
                                                                        <div class="fw-bold">@item.OneTimeTransaction.AreaOfServices</div>
                                                                    </div>
                                                                    @if (!string.IsNullOrWhiteSpace(item.OneTimeTransaction.OtherAreaOfServices))
                                                                    {
                                                                        <div class="col-12">
                                                                            <small class="text-muted">Other Area</small>
                                                                            <div class="fw-bold">@item.OneTimeTransaction.OtherAreaOfServices</div>
                                                                        </div>
                                                                    }
                                                                </div>
                                                            }
                                                            else if (item.TypeOfProject == "External Audit" && item.ExternalAudit != null)
                                                            {
                                                                <div class="row g-3">
                                                                    <div class="col-12 col-md-6">
                                                                        <small class="text-muted">Audit Status</small>
                                                                        <div class="fw-bold">@item.ExternalAudit.ExternalAuditStatus</div>
                                                                    </div>
                                                                    @if (!string.IsNullOrWhiteSpace(item.ExternalAudit.ExternalAuditPurposes))
                                                                    {
                                                                        <div class="col-12">
                                                                            <small class="text-muted">Purposes</small>
                                                                            <div class="fw-bold">@item.ExternalAudit.ExternalAuditPurposes</div>
                                                                        </div>
                                                                    }
                                                                    @if (!string.IsNullOrWhiteSpace(item.ExternalAudit.ExternalAuditOtherPurpose))
                                                                    {
                                                                        <div class="col-12">
                                                                            <small class="text-muted">Other Purpose</small>
                                                                            <div class="fw-bold">@item.ExternalAudit.ExternalAuditOtherPurpose</div>
                                                                        </div>
                                                                    }
                                                                    <div class="col-12 col-md-6">
                                                                        <small class="text-muted">Report Date</small>
                                                                        <div class="fw-bold">@item.ExternalAudit.ExternalAuditReportDate?.ToString("yyyy-MM-dd")</div>
                                                                    </div>
                                                                </div>
                                                            }
                                                        </div>

                                                        <hr class="my-4" />
                                                        
                                                        <!-- Permit Requirements Section -->
                                                        @{
                                                            var reqMap = ViewBag.Requirements as System.Collections.Generic.Dictionary<int, System.Collections.Generic.List<TestingDemo.Models.PermitRequirementModel>>;
                                                            var reqs = (reqMap != null && reqMap.ContainsKey(item.Id)) ? reqMap[item.Id] : new System.Collections.Generic.List<TestingDemo.Models.PermitRequirementModel>();
                                                        }
                                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                                            <h6 class="fw-bold mb-0 text-primary">
                                                                <i class="bi bi-list-check me-2"></i>Permit Requirements
                                                            </h6>
                                                            <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addReqModal-@item.Id">
                                                                <i class="bi bi-plus-lg"></i> Add Requirement
                                                            </button>
                                                        </div>
                                                        <div class="border rounded p-3 bg-light" id="req-list-@item.Id">
                                                            @await Html.PartialAsync("_RequirementsList", reqs)
                                                        </div>

                                                        <!-- Add Requirement Modal -->
                                                        <div class="modal fade" id="addReqModal-@item.Id" tabindex="-1" aria-hidden="true">
                                                            <div class="modal-dialog">
                                                                <div class="modal-content">
                                                                    <div class="modal-header">
                                                                        <h5 class="modal-title">
                                                                            <i class="bi bi-plus-circle me-2"></i>Add Requirement
                                                                        </h5>
                                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                                    </div>
                                                                    <form asp-action="AddRequirement" method="post">
                                                                        @Html.AntiForgeryToken()
                                                                        <div class="modal-body">
                                                                            <input type="hidden" name="ClientId" value="@item.Id" />
                                                                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                                                            <div class="mb-3">
                                                                                <label class="form-label">
                                                                                    <i class="bi bi-card-text me-1"></i>Requirement Name <span class="text-danger">*</span>
                                                                                </label>
                                                                                <textarea name="RequirementName" class="form-control" rows="3" 
                                                                                          placeholder="Enter the requirement name..." required></textarea>
                                                                            </div>
                                                                            <div class="mb-3">
                                                                                <label class="form-label">
                                                                                    <i class="bi bi-chat-left-text me-1"></i>Description <span class="text-danger">*</span>
                                                                                </label>
                                                                                <textarea name="Description" class="form-control" rows="3" 
                                                                                          placeholder="Provide detailed description..." required></textarea>
                                                                            </div>
                                                                            <div class="form-check mb-2">
                                                                                <input class="form-check-input" type="checkbox" id="isRequired-@item.Id" name="IsRequired" value="true" checked>
                                                                                <input type="hidden" name="IsRequired" value="false">
                                                                                <label class="form-check-label" for="isRequired-@item.Id">
                                                                                    <i class="bi bi-exclamation-circle me-1"></i>Required
                                                                                </label>
                                                                            </div>
                                                                        </div>
                                                                        <div class="modal-footer">
                                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                                                                <i class="bi bi-x-circle me-1"></i>Cancel
                                                                            </button>
                                                                            <button type="submit" class="btn btn-primary">
                                                                                <i class="bi bi-plus-lg me-1"></i>Add Requirement
                                                                            </button>
                                                                        </div>
                                                                    </form>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer bg-light">
                                                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                                                            <i class="bi bi-x-circle me-1"></i>Close
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <div class="mb-3">
                                <i class="bi bi-inbox display-1 text-muted"></i>
                            </div>
                            <h5 class="text-muted mb-2">No Clients Found</h5>
                            <p class="text-muted">There are no pending clients available at the moment.</p>
                        </div>
                    }
                </div>
                <div class="card-footer bg-light">
                    <nav aria-label="Page navigation">
                        <ul class="pagination justify-content-center mb-0">
                            @{
                                var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
                                var nextDisabled = !Model.HasNextPage ? "disabled" : "";
                                var currentAction = ViewData["CurrentAction"] as string;
                            }
                            <li class="page-item @prevDisabled">
                                <a asp-action="@currentAction" asp-route-pageNumber="@(Model.PageIndex - 1)" class="page-link">
                                    <i class="bi bi-chevron-left"></i> Previous
                                </a>
                            </li>
                            <li class="page-item active" aria-current="page">
                                <span class="page-link fw-bold">Page @Model.PageIndex of @Model.TotalPages</span>
                            </li>
                            <li class="page-item @nextDisabled">
                                <a asp-action="@currentAction" asp-route-pageNumber="@(Model.PageIndex + 1)" class="page-link">
                                    Next <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Resolve correct base URL (supports virtual directories)
        var requirementsUrlBase = '@Url.Action("Requirements", "PlanningOfficer")/';
        
        $(function () {
            // Initialize tooltips
            $('[data-bs-toggle="tooltip"]').tooltip();
            
            // Handle modal cleanup when closed
            $('.modal').on('hidden.bs.modal', function () {
                $('.modal-backdrop').remove();
                $('body').removeClass('modal-open');
                $('body').css('padding-right', '');
            });
            
            // Auto-dismiss alerts after 5 seconds
            $('.alert-dismissible').each(function() {
                var alert = this;
                setTimeout(function() {
                    $(alert).fadeOut('slow', function() {
                        $(this).remove();
                    });
                }, 5000);
            });
        });

        // Load requirements when modal is shown
        document.addEventListener('shown.bs.modal', function (event) {
            var trigger = event.target;
            if (!trigger || !trigger.id || !trigger.id.startsWith('clientModal-')) return;
            
            var clientId = trigger.id.replace('clientModal-', '');
            var targetElement = document.getElementById('req-list-' + clientId);
            
            if (targetElement) {
                var url = requirementsUrlBase + clientId + '?t=' + Date.now();
                console.debug('[Requirements] Loading requirements for client:', clientId);
                
                fetch(url, { 
                    cache: 'no-store',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                .then(function (response) { 
                    if (!response.ok) throw new Error('Network response was not ok');
                    return response.text(); 
                })
                .then(function (html) {
                    targetElement.innerHTML = html;
                    console.debug('[Requirements] Successfully loaded requirements for client:', clientId);
                })
                .catch(function (error) { 
                    console.error('[Requirements] Error loading requirements:', error);
                    targetElement.innerHTML = '<div class="alert alert-warning"><i class="bi bi-exclamation-triangle"></i> Failed to load requirements. Please try again.</div>';
                });
            }
        });

        // Re-open client modal after redirect if flagged by server
        (function() {
            var openClientId = '@(TempData["OpenClientId"] ?? "")';
            if (openClientId) {
                var modalElement = document.getElementById('clientModal-' + openClientId);
                if (modalElement) {
                    var modal = new bootstrap.Modal(modalElement);
                    modal.show();
                    console.debug('[Modal] Reopened modal for client:', openClientId);
                }
            }
        })();

        // Real-time updates (if SignalR is available)
        if (window.connection) {
            connection.on("ReceiveUpdate", function (message) {
                console.debug('[SignalR] Received update:', message);
                // Reload the page to get latest data
                location.reload();
            });
        }

        // Form validation enhancement
        $('form').on('submit', function() {
            var form = this;
            var submitBtn = $(form).find('button[type="submit"]');
            
            // Disable submit button to prevent double submission
            submitBtn.prop('disabled', true);
            submitBtn.html('<i class="bi bi-hourglass-split me-1"></i>Processing...');
            
            // Re-enable after 3 seconds as fallback
            setTimeout(function() {
                submitBtn.prop('disabled', false);
                submitBtn.html(submitBtn.data('original-text') || 'Submit');
            }, 3000);
        });

        // Store original button text
        $('button[type="submit"]').each(function() {
            $(this).data('original-text', $(this).html());
        });
    </script>
    
    <!-- Success Toast -->
    <div class="position-fixed top-0 end-0 p-3" style="z-index: 1080;">
        <div id="successToast" class="toast align-items-center text-bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    <span class="toast-message">Success</span>
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>
}