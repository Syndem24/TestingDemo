@model IEnumerable<TestingDemo.Models.PermitRequirementModel>

@if (Model != null && Model.Any())
{
    <div style="max-height: 300px; overflow-y: auto; border: 1px solid #dee2e6; border-radius: 0.375rem;">
        <table class="table table-sm mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 36px;" class="text-center">#</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th class="text-center">Required</th>
                    <th class="text-center">Status</th>
                    <th class="text-center" style="width: 80px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @{
                    var i = 1;
                }
                @foreach (var r in Model)
                {
                    <tr>
                        <td class="text-center">@i</td>
                        <td>@r.RequirementName</td>
                        <td class="text-muted">@r.Description</td>
                        <td class="text-center">@(r.IsRequired ? Html.Raw("<span class=\"badge bg-danger\">Required</span>") :
                                        Html.Raw("<span class=\"badge bg-secondary\">Optional</span>"))</td>
                <td class="text-center">@(r.IsCompleted ? Html.Raw("<span class=\"badge bg-success\">Completed</span>")
                                            : Html.Raw("<span class=\"badge bg-warning text-dark\">Pending</span>"))</td>
                <td class="text-center">
                    <a class="btn btn-sm btn-outline-primary" asp-action="EditRequirement"
                        asp-controller="PlanningOfficer" asp-route-id="@r.Id" title="Edit this requirement">
                        <i class="bi bi-pencil"></i>
                    </a>
                </td>
            </tr>
                        i++;
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info py-2"><i class="bi bi-info-circle"></i> No requirements defined for this client.</div>
}
